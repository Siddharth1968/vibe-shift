# VibeShift Backend Environment Configuration
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env with private values.

# Optional override for Phase 12 CleanBTNVit checkpoint path
# Default: backend/ai/models/clean_btn_vit_phase12.pt
# VIBESHIFT_BTN_WEIGHTS=backend/ai/models/clean_btn_vit_phase12.pt

# Optional override for YuNet ONNX face detector path
# Default: backend/ai/models/yunet-2023mar.onnx
# VIBESHIFT_YUNET_MODEL=backend/ai/models/yunet-2023mar.onnx

# Optional compute device override ("cuda" or "cpu"). Auto-detects CUDA by default.
# VIBESHIFT_DEVICE=cuda

# Default inference mode: "false" = single-view (fast, default), "true" = horizontal-flip accuracy mode
VIBESHIFT_DEFAULT_FLIP=false

# Optional comma-separated additional CORS origins
# VIBESHIFT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional override for SQLite database path (default: backend/database/vibeshift.db)
# VIBESHIFT_DB_PATH=backend/database/vibeshift.db
